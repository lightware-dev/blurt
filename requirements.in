# Parakeet dictation server (local, GPU) — the hand-edited source.
#
# requirements.txt beside it is generated from this file: every dependency
# pinned to an exact version with its artifact hashes, so `docker build` today
# and next month install the same tree, and a compromised upstream release
# fails the hash check instead of landing silently. Edit here, then run:
#
#   ./scripts/lock-requirements.sh
#
# ---- why torch is pinned here but excluded from the lock ----
#
# The Dockerfile installs torch from the PyTorch cu130 index *before* this file,
# because those wheels bundle the CUDA + cuDNN runtime. It must not be installed
# again from PyPI, which would clobber the cu130 build with a generic one — so
# torch, triton and the nvidia-* runtime packages that come with it are resolved
# (to keep the rest of the tree consistent with them) and then omitted from the
# output. See scripts/lock-requirements.sh for the exclusion list.
#
# The pin below exists purely so the resolver knows which torch will be present.
# Without it the resolution drifts to whatever PyPI's newest torch is — 2.13.0
# at the time of writing — and pins everything else against a torch the image
# never installs. Keep this in lockstep with the Dockerfile's cu130 install.
torch==2.12.1

fastapi>=0.115.0
python-multipart>=0.0.9   # multipart forms for the OpenAI-compatible /v1 API
uvicorn>=0.30.0
websockets>=13.0
nemo_toolkit[asr]>=2.0.0
# The Whisper engine (BLURT_ASR_ENGINE=whisper) runs Whisper through
# transformers. NeMo already pulls it in, so this changes nothing in the
# resolved tree — it is stated because server/whisper.py imports it directly,
# and a NeMo release that dropped the dependency would otherwise break that
# engine silently at run time rather than here.
transformers>=4.44.0
# 4-bit weights (PARAKEET_DTYPE=nvfp4). Only imported when that precision is
# selected, but it ships in the image so the option works out of the box; it is
# ~15 MB and its dependencies are already pulled in by NeMo.
nvidia-modelopt>=0.45.0
# 4-bit weights for the Whisper engine (WHISPER_DTYPE=nf4). A second quantizer
# looks redundant beside modelopt, and it is not: modelopt's NVFP4 costs Whisper
# 4.1x decode latency where bitsandbytes' NF4 costs 1.7x, because bitsandbytes
# fuses dequantization into the matmul instead of unpacking to bf16 first. See
# server/whisper.py. Unlike the runtimes that module declines to take on, this
# one links against torch's own CUDA rather than shipping a second copy of it.
bitsandbytes>=0.50.0
silero-vad>=5.1
soundfile>=0.12.0
librosa>=0.10.0
numpy>=1.26.0
python-dotenv>=1.0.0
