#!/usr/bin/env bash
# blurtd — the Blurt dictation daemon.
#
# A thin wrapper around `python -m server`. And yes: "blurtd" is the past tense
# of the thing it does. A daemon named "blurted." We're at peace with it.
#
#   ./blurtd                      # serve parakeet-tdt-0.6b-v3 (bf16, GPU)
#   ./blurtd --port 8000          # on another port
set -euo pipefail
cd "$(dirname "$0")"

# Prefer the project virtualenv if present, unless PYTHON is set explicitly.
if [[ -z "${PYTHON:-}" && -x .venv/bin/python ]]; then
  PYTHON=.venv/bin/python
fi

exec "${PYTHON:-python}" -m server "$@"
