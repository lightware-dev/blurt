# Parakeet dictation server — all optional (sane defaults in code).

# Which model to load (alias or full HF id). See: python -m server --list-models
# PARAKEET_MODEL=v3          # v3 (multilingual, default) | v2 (English) | 1.1b | ctc-110m
# PARAKEET_FP32=1            # load in fp32 (default bf16, ~half the VRAM)

# Network
# HOST=0.0.0.0
# PORT=7860
# AUTH_TOKEN=changeme        # if set, clients must connect with ?token=changeme

# Streaming / VRAM tuning
# SILENCE_MS=600             # pause length that commits a segment
# PARTIAL_INTERVAL_MS=350    # how often live partials are emitted
# MAX_SEGMENT_S=20           # force-commit an unbroken utterance at this length (caps VRAM)
# MIN_SEGMENT_S=0.3          # ignore segments shorter than this
