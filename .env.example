# Blurt dictation server — all optional (sane defaults in code).
# One ASR engine runs per process, in half precision on the GPU.

# ---- engine ----------------------------------------------------------------
# Which model this server runs: parakeet (default) or whisper. One at a time —
# switching means a restart, since two resident models would double the VRAM.
# `blurtd --engine whisper` does the same thing from the command line.
# BLURT_ASR_ENGINE=whisper

# ---- parakeet (BLURT_ASR_ENGINE=parakeet, the default) ----------------------
# nvidia/parakeet-tdt-0.6b-v3 — ~1.4 GB in bf16, 25 European languages.

# Weight precision: bf16 (default), fp16 or nvfp4. Any of them is downloaded on
# first start.
#
# fp16 — for a pre-Ampere GPU (sm_75 — GTX 16xx, RTX 20xx), which has no bf16
#   support at all. Same size and speed as bf16, same accuracy.
# PARAKEET_DTYPE=fp16
#
# nvfp4 — 4-bit encoder weights. Halves VRAM (0.78 GB against 1.43) at no
#   measurable accuracy cost, but decodes ~2.4x slower. Choose it when memory is
#   what you are short of, not for speed. Needs a bf16-capable GPU.
# PARAKEET_DTYPE=nvfp4

# Override where each checkpoint is cached (default ~/.cache/blurt/). nvfp4 is a
# directory, the other two are single files:
# PARAKEET_BF16_CKPT=/path/to/parakeet-tdt-0.6b-v3-bf16.nemo
# PARAKEET_FP16_CKPT=/path/to/parakeet-tdt-0.6b-v3-fp16.nemo
# PARAKEET_NVFP4_SNAPSHOT=/path/to/parakeet-tdt-0.6b-v3-nvfp4

# Override the HuggingFace repo the pre-built checkpoints are downloaded from
# (default lightware-dev/parakeet-tdt-0.6b-v3; it holds the bf16 and fp16 .nemo
# files and the nvfp4 snapshot directory side by side, picked by PARAKEET_DTYPE):
# PARAKEET_REPO=your-org/parakeet-tdt-0.6b-v3

# ---- whisper (BLURT_ASR_ENGINE=whisper) ------------------------------------
# openai/whisper-large-v3-turbo by default — 809M params, ~1.6 GB in bf16, ~100
# languages. Weights come from the HuggingFace cache (~/.cache/huggingface), not
# from the ~/.cache/blurt checkpoints above.

# Any Whisper checkpoint on the Hub: openai/whisper-large-v3 (better, ~3.1 GB,
# ~2x slower), openai/whisper-small (~0.5 GB), a fine-tune of your own. The
# English-only `.en` checkpoints work too — language/task settings are ignored
# for them.
# WHISPER_MODEL=openai/whisper-large-v3-turbo

# bf16 (default) or fp16 for pre-Ampere cards (sm_75 — GTX 16xx, RTX 20xx).
# There is no 4-bit option here; nvfp4 is Parakeet-only.
# WHISPER_DTYPE=fp16

# Language. Unset (or `auto`) detects it per dictation, which is what you want
# if you switch languages. Pin it when you always dictate in one: detection runs
# off the first window and a short, noisy start is where it goes wrong.
# WHISPER_LANGUAGE=en

# transcribe (default) keeps the spoken language; translate emits English for
# any input.
# WHISPER_TASK=translate

# Network
# HOST=0.0.0.0
# PORT=25878                 # default: 2-5-8-7-8 spells "BLURT" on a phone keypad
# AUTH_TOKEN=changeme        # if set, clients must connect with ?token=changeme
# BLURT_CERT_DIR=/path/to/certs   # where cert.pem/key.pem live (default: ./certs)

# Streaming / VRAM tuning
# SILENCE_MS=600             # pause length that commits a segment
# PARTIAL_INTERVAL_MS=350    # how often live partials are emitted
# MAX_SEGMENT_S=20           # force-commit an unbroken utterance at this length (caps VRAM)
# MIN_SEGMENT_S=0.3          # ignore segments shorter than this

# Speech gating — audio the VAD rejects never reaches the model, so background
# chatter can't be transcribed. Raise these if words lose their first or last
# sound; lower them if too much room noise still gets through.
# VAD_THRESHOLD=0.5          # how sure Silero must be; raise for a noisy room
# VAD_PREROLL_MS=250         # audio kept before speech is detected
# VAD_HANGOVER_MS=200        # audio kept after speech ends

# Logging
# LOG_STATS=0                # silence per-dictation metadata (packets/bytes/duration; never text)
