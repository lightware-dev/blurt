# Parakeet dictation server — all optional (sane defaults in code).
# The model is fixed: parakeet-tdt-0.6b-v3 in half precision on the GPU.

# Weight precision: bf16 (default) or fp16. Only switch to fp16 for a pre-Ampere
# GPU (sm_75 — GTX 16xx, RTX 20xx), which has no bf16 support at all. Either
# checkpoint is downloaded on first start.
# PARAKEET_DTYPE=fp16

# Override where each checkpoint is cached (default ~/.cache/blurt/):
# PARAKEET_BF16_CKPT=/path/to/parakeet-tdt-0.6b-v3-bf16.nemo
# PARAKEET_FP16_CKPT=/path/to/parakeet-tdt-0.6b-v3-fp16.nemo

# Override the HuggingFace repo both pre-built checkpoints are downloaded from
# (default lightware-dev/parakeet-tdt-0.6b-v3; it holds the bf16 and fp16 .nemo
# files side by side, picked by PARAKEET_DTYPE):
# PARAKEET_REPO=your-org/parakeet-tdt-0.6b-v3

# Network
# HOST=0.0.0.0
# PORT=25878                 # default: 2-5-8-7-8 spells "BLURT" on a phone keypad
# AUTH_TOKEN=changeme        # if set, clients must connect with ?token=changeme
# BLURT_CERT_DIR=/path/to/certs   # where cert.pem/key.pem live (default: ./certs)

# Streaming / VRAM tuning
# SILENCE_MS=600             # pause length that commits a segment
# PARTIAL_INTERVAL_MS=350    # how often live partials are emitted
# MAX_SEGMENT_S=20           # force-commit an unbroken utterance at this length (caps VRAM)
# MIN_SEGMENT_S=0.3          # ignore segments shorter than this

# Speech gating — audio the VAD rejects never reaches the model, so background
# chatter can't be transcribed. Raise these if words lose their first or last
# sound; lower them if too much room noise still gets through.
# VAD_THRESHOLD=0.5          # how sure Silero must be; raise for a noisy room
# VAD_PREROLL_MS=250         # audio kept before speech is detected
# VAD_HANGOVER_MS=200        # audio kept after speech ends

# Logging
# LOG_STATS=0                # silence per-dictation metadata (packets/bytes/duration; never text)
